# Apache / LiteSpeed (Hostinger)
Options -Indexes
# index.html first, so Hostinger's default placeholder page never wins
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On
# Force HTTPS and the bare domain (works for any domain, no hard-coded name)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Add trailing slash to page URLs (/franchise -> /franchise/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-z0-9]+|/)$ [NC]
RewriteRule ^(.*)$ /$1/ [L,R=301]

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|css|js|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest
