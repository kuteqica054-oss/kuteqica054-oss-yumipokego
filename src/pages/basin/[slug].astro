---
import PressArticle from '../../views/PressArticle.astro';
import press from '../../data/press.json';
export function getStaticPaths() {
  return press.items.map((item) => ({ params: { slug: item.slug.tr }, props: { item } }));
}
const { item } = Astro.props;
---
<PressArticle lang="tr" item={item} />
