---
import type { Lang } from '../i18n/routes';
import { path } from '../i18n/routes';
import { useT, pick } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import menu from '../data/menu.json';
import photos from '../config/photos.json';
import PageHero from '../components/ui/PageHero.astro';
import PhotoSlot from '../components/ui/PhotoSlot.astro';
import Todo from '../components/ui/Todo.astro';
import Icon from '../components/ui/Icon.astro';
import MenuGrid from '../components/sections/MenuGrid.astro';
import HeroBowl from '../components/art/HeroBowl.astro';
import Storefront from '../components/art/Storefront.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const p = t.menuPage;
---
<BaseLayout lang={lang} routeKey="menu">
  <PageHero lang={lang} eyebrow={p.eyebrow} title={p.title} lead={p.lead} crumbs={[{ label: t.nav.menu }]}>
    <div slot="actions" class="mt-8 flex flex-wrap gap-3">
      <a href={path('locations', lang)} class="btn-dark"><Icon name="MapPin" size={18} />{p.locationsLink}</a>
    </div>
    <div slot="art" class="mx-auto w-full max-w-[400px]">
      <PhotoSlot src={photos.heroBowl.src} alt={pick(photos.heroBowl.alt, lang)} size={photos.heroBowl.size} imgClass="aspect-square w-full rounded-full object-cover">
        <HeroBowl alt={t.home.hero.bowlAlt} />
      </PhotoSlot>
    </div>
  </PageHero>

  <p class="container-x pt-10 text-sm text-ink-soft">{p.sampleNote}</p>

  {menu.categories.map((c) => (
    <section class="container-x py-10" aria-labelledby={`cat-${c.id}`}>
      <h2 id={`cat-${c.id}`} class="h-section mb-8">{pick(c.name, lang)}</h2>
      <MenuGrid lang={lang} category={c.id} />
    </section>
  ))}

  <section class="container-x py-14" aria-labelledby="build">
    <div class="rounded-[28px] bg-avocado-50 p-6 ring-1 ring-avocado-100 sm:p-10">
      <h2 id="build" class="h-section">{p.buildTitle}</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {p.buildSteps.map((s, i) => (
          <li>
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-avocado-700 font-display text-lg font-bold text-white">{i + 1}</span>
            <h3 class="mt-3 text-xl font-bold">{s.title}</h3>
            <p class="mt-1 text-ink-soft">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-sm text-ink-soft">{p.allergenNote}</p>
    </div>
  </section>

  <section class="container-x grid gap-10 pb-20 pt-6 lg:grid-cols-2">
    <div>
      <h2 class="h-section">{p.brandTitle}</h2>
      <p class="lead mt-4">{p.brandText}</p>
      <a href={path('franchise', lang)} class="link mt-6 inline-block font-semibold">{t.common.forInvestors}: {t.nav.franchise} →</a>
    </div>
    <PhotoSlot src={photos.interior.src} alt={pick(photos.interior.alt, lang)} size={photos.interior.size} class="aspect-[16/10] overflow-hidden rounded-[var(--radius-card)] bg-coral-50">
      <div class="flex h-full items-center justify-center p-6"><div class="w-full max-w-[380px]"><Storefront alt={t.home.hero.storeAlt} openLabel={lang === 'tr' ? 'AÇIK' : 'OPEN'} /></div></div>
    </PhotoSlot>
  </section>
</BaseLayout>
