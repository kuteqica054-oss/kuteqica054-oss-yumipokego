---
import type { Lang } from '../i18n/routes';
import { path } from '../i18n/routes';
import { useT } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site.json';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import Todo from '../components/ui/Todo.astro';
import ApplyForm from '../components/form/ApplyForm.astro';
import Disclaimer from '../components/sections/Disclaimer.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const steps = t.process.slice(0, 4);
---
<BaseLayout lang={lang} routeKey="apply">
  <PageHero lang={lang} eyebrow={t.nav.franchise} title={t.common.apply} lead={t.meta.apply.description} crumbs={[{ label: t.nav.franchise, href: path('franchise', lang) }, { label: t.common.applyShort }]} />
  <section class="container-x grid gap-10 py-14 lg:grid-cols-[1.4fr_0.6fr]">
    <div class="rounded-[28px] bg-white p-5 ring-1 ring-line sm:p-10"><ApplyForm lang={lang} /></div>
    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h2 class="text-xl font-bold">{t.form.thanks.nextTitle}</h2>
        <ol class="mt-4 space-y-4">
          {steps.map((s, i) => (
            <li class="flex gap-3"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-bold text-white">{i + 1}</span><div><p class="font-semibold">{s.title}</p><p class="text-sm text-ink-soft">{s.text}</p></div></li>
          ))}
        </ol>
        <a href={path('process', lang)} class="link mt-4 inline-block text-sm font-semibold">{t.home.process.link} →</a>
      </div>
      <div class="on-dark rounded-[var(--radius-card)] bg-ink p-6 text-white">
        <p class="font-semibold">{t.contactPage.franchise}</p>
        <p class="mt-3 flex items-center gap-2 text-sm"><Icon name="Mail" size={16} />{site.contacts.franchise.email ? <a class="underline" href={`mailto:${site.contacts.franchise.email}`}>{site.contacts.franchise.email}</a> : <Todo />}</p>
        <p class="mt-2 flex items-center gap-2 text-sm"><Icon name="Phone" size={16} />{site.contacts.franchise.phone ?? <Todo />}</p>
      </div>
      <Disclaimer lang={lang} />
    </aside>
  </section>
</BaseLayout>
