---
import { siInstagram, siTiktok, siYoutube, siX, siWhatsapp } from 'simple-icons';
interface Props { name: 'instagram' | 'tiktok' | 'youtube' | 'linkedin' | 'x' | 'whatsapp'; size?: number; class?: string }
const { name, size = 20, class: cls = '' } = Astro.props;
// LinkedIn Simple Icons'tan kaldırıldığı için sade bir "in" çizimi kullanılıyor.
const linkedin = 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75ZM9.5 9.75h3.83v1.6h.05c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.66 4.8 6.12V21h-4v-4.94c0-1.18-.02-2.7-1.64-2.7-1.65 0-1.9 1.29-1.9 2.61V21H9.5V9.75Z';
const paths = { instagram: siInstagram.path, tiktok: siTiktok.path, youtube: siYoutube.path, x: siX.path, whatsapp: siWhatsapp.path, linkedin };
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={cls} aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
