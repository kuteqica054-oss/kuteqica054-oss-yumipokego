---
import type { Lang } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { useT, absUrl } from '../../i18n/utils';
interface Props { lang: Lang; eyebrow: string; title: string; lead?: string; crumbs?: { label: string; href?: string }[]; tone?: 'light' | 'dark' }
const { lang, eyebrow, title, lead, crumbs = [], tone = 'light' } = Astro.props;
const t = useT(lang);
const all = [{ label: t.common.home, href: path('home', lang) }, ...crumbs];
const dark = tone === 'dark';
const hasArt = Astro.slots.has('art');
---
<section class:list={['relative overflow-hidden', dark ? 'on-dark pattern-rice-dark bg-ink text-white' : 'pattern-rice bg-rice-2']}>
  <div class:list={['container-x relative grid items-center gap-10 py-12 md:py-16', hasArt && 'lg:grid-cols-[1.25fr_1fr]']}>
    <div>
      <nav aria-label={t.common.breadcrumb}>
        <ol class:list={['flex flex-wrap items-center gap-1.5 text-sm', dark ? 'text-ink-mute' : 'text-ink-soft']}>
          {all.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href && i < all.length - 1 ? <a class="hover:underline" href={c.href}>{c.label}</a> : <span aria-current={i === all.length - 1 ? 'page' : undefined}>{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
      <p class="eyebrow mt-6">{eyebrow}</p>
      <h1 class:list={['h-display mt-3 max-w-[18ch]', dark && 'text-white']}>{title}</h1>
      {lead && <p class="lead mt-5 max-w-2xl">{lead}</p>}
      <slot name="actions" />
    </div>
    {hasArt && <div class="relative"><slot name="art" /></div>}
  </div>
  <svg class:list={['absolute inset-x-0 bottom-0 h-4 w-full', dark ? 'text-rice' : 'text-rice']} viewBox="0 0 1200 16" preserveAspectRatio="none" aria-hidden="true"><path d="M0 16 V8 Q 50 0 100 8 T 200 8 T 300 8 T 400 8 T 500 8 T 600 8 T 700 8 T 800 8 T 900 8 T 1000 8 T 1100 8 T 1200 8 V16 Z" fill="currentColor"/></svg>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: absUrl(c.href) } : {}) })) })} />
</section>
