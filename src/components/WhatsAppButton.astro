---
import type { Lang } from '../i18n/routes';
import { path } from '../i18n/routes';
import { useT } from '../i18n/utils';
import site from '../config/site.json';
import SocialIcon from './ui/SocialIcon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const num = site.contacts.whatsapp;
const text = encodeURIComponent(lang === 'tr' ? 'Merhaba, YumiPokeGo franchise hakkında bilgi almak istiyorum.' : 'Hello, I would like information about the YumiPokeGo franchise.');
// TODO: site.json → contacts.whatsapp doldurulana kadar buton iletişim sayfasına gider.
const href = num ? `https://wa.me/${num}?text=${text}` : `${path('contact', lang)}#whatsapp`;
---
{(num || site.showTodos) && <a href={href} target={num ? '_blank' : undefined} rel={num ? 'noopener' : undefined}
   class="fixed bottom-4 right-4 z-30 flex h-14 w-14 items-center justify-center rounded-full bg-avocado-700 text-white shadow-[0_10px_30px_-10px_rgb(14_42_59/0.6)] transition-transform hover:scale-105 focus-visible:scale-105"
   aria-label={num ? t.common.whatsapp : `${t.common.whatsapp} — ${t.common.whatsappTodo}`} title={num ? t.common.whatsapp : t.common.whatsappTodo}>
  <SocialIcon name="whatsapp" size={26} />
</a>}
