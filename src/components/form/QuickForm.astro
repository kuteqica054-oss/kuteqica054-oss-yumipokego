---
// Ana sayfadaki kısa ön başvuru formu (tek adım).
import type { Lang } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { useT, pick } from '../../i18n/utils';
import site from '../../config/site.json';
import formats from '../../data/formats.json';
import Field from './Field.astro';
import Icon from '../ui/Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const F = t.form.fields;
const common = { requiredText: t.form.required, optionalText: t.form.optional, selectText: t.form.select, idPrefix: 'qf' };
const formatOpts = [...formats.formats.map((f) => ({ value: f.id, label: pick(f.name, lang) })), { value: 'unsure', label: F.formatUnsure }];
const formName = 'franchise-on-basvuru';
const kvkkParts = F.kvkk.split('{link}');
const msgs = { ...t.form.errors, sending: t.form.sending, stepOf: t.form.stepOf };
---
<div data-form-wrap class="scroll-mt-24">
  <form name={formName} method="POST" action={site.form.provider === 'php' ? '/form.php' : `${path('home', lang)}?sent=1#on-basvuru`} data-netlify="true" netlify-honeypot="bot-field" novalidate
        data-apply-form data-provider={site.form.provider} data-formspree={site.form.formspreeId ?? ''} data-msgs={JSON.stringify(msgs)} class="grid gap-5 sm:grid-cols-2">
    <input type="hidden" name="form-name" value={formName} />
    <input type="hidden" name="site_language" value={lang} />
    <input type="hidden" name="form_type" value="quick" />
    <input type="hidden" name="page" value="" />
    <p class="hidden" aria-hidden="true"><label>Bot <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    <p data-summary role="alert" tabindex="-1" class="hidden rounded-xl border border-coral-600 bg-coral-50 px-4 py-3 font-semibold text-coral-700 sm:col-span-2"></p>
    <Field name="first_name" label={`${F.firstName} ${lang === 'tr' ? 've soyad' : '& last name'}`} required autocomplete="name" {...common} />
    <Field name="phone" type="tel" label={F.phone} required autocomplete="tel" inputmode="tel" {...common} />
    <Field name="email" type="email" label={F.email} required autocomplete="email" {...common} />
    <Field name="region" label={F.region} required {...common} />
    <Field name="format" label={F.format} options={formatOpts} class="sm:col-span-2" {...common} />
    <div class="space-y-3 sm:col-span-2">
      <div class="field" data-field="kvkk_consent">
        <label class="flex cursor-pointer items-start gap-3">
          <input type="checkbox" name="kvkk_consent" value="yes" required class="mt-1 h-5 w-5 shrink-0 accent-[#c4442a]" aria-describedby="qf-kvkk-err" />
          <span class="text-[0.95rem]">{kvkkParts[0]}<a href={path('privacy', lang)} target="_blank" class="link font-semibold">{F.kvkkLink}</a>{kvkkParts[1]}</span>
        </label>
        <p id="qf-kvkk-err" class="mt-1 hidden text-sm font-medium text-coral-700" data-error></p>
      </div>
      <label class="flex cursor-pointer items-start gap-3">
        <input type="checkbox" name="marketing_consent" value="yes" class="mt-1 h-5 w-5 shrink-0 accent-[#c4442a]" />
        <span class="text-sm text-ink-soft">{F.marketing} ({t.form.optional})</span>
      </label>
    </div>
    <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
      <button type="submit" class="btn-primary">{t.home.form.submit}</button>
      <a href={path('apply', lang)} class="link font-semibold">{t.home.form.full} →</a>
    </div>
  </form>
  <div data-thanks hidden class="rounded-2xl bg-white p-6 ring-1 ring-line">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-avocado-100 text-avocado-700"><Icon name="Check" size={24} stroke={2.5} /></span>
    <h3 tabindex="-1" class="mt-4 text-2xl font-bold">{t.form.thanks.title}</h3>
    <p class="mt-2 text-ink-soft">{t.form.thanks.text}</p>
    <ol class="mt-4 list-decimal space-y-1 pl-5 text-[0.95rem] text-ink-soft">
      {t.form.thanks.next.map((s) => <li set:html={s.replace(/\[TODO: ([^\]]+)\]/g, '<span class="todo">TODO: $1</span>')} />)}
    </ol>
    <a href={path('apply', lang)} class="btn-dark mt-6">{t.home.form.full}</a>
  </div>
</div>
<script>
  import { initForms } from '../../scripts/forms';
  initForms();
</script>
