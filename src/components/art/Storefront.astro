---
// Şematik restoran cephesi (cadde mağazası). Gerçek cephe fotoğrafı geldiğinde PhotoSlot ile değiştirilir.
interface Props { alt: string; class?: string; openLabel?: string }
const { alt, class: cls = '', openLabel = 'AÇIK' } = Astro.props;
---
<svg viewBox="0 0 360 290" class:list={['block h-auto w-full', cls]} role="img" aria-label={alt}>
  <rect x="0" y="270" width="360" height="20" fill="#ebe1cf"/>
  <rect x="14" y="20" width="332" height="252" rx="6" fill="#f4ede1" stroke="#0e2a3b" stroke-width="3"/>
  <!-- tabela -->
  <rect x="14" y="20" width="332" height="56" rx="6" fill="#0e2a3b"/>
  <g transform="translate(40 48)">
    <circle r="16" fill="#fbf7f0"/><path d="M0 0 L0 -13 A13 13 0 0 1 12.4 -4 Z" fill="#ee6a4e"/><path d="M0 0 L12.4 -4 A13 13 0 0 1 7.6 10.5 Z" fill="#6e9a3c"/><path d="M0 0 L7.6 10.5 A13 13 0 0 1 -7.6 10.5 Z" fill="#f5b83d"/><path d="M0 0 L-7.6 10.5 A13 13 0 0 1 -12.4 -4 Z" fill="#9fc46a"/><circle r="4" fill="#fbf7f0"/>
  </g>
  <text x="66" y="57" font-family="Bricolage Grotesque Variable, sans-serif" font-weight="800" font-size="27" fill="#fbf7f0" letter-spacing="-1">Yumi<tspan fill="#ee6a4e">Poke</tspan><tspan fill="#9fc46a">Go</tspan></text>
  <text x="330" y="56" text-anchor="end" font-family="DM Sans Variable, sans-serif" font-size="11" fill="#b9c7d0">poke · wok · roll</text>
  <!-- tente: dalga kenarlı -->
  <rect x="24" y="76" width="312" height="20" fill="#ee6a4e"/>
  <path d="M24 96 q13 12 26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 t26 0 v-4 h-312 z" fill="#ee6a4e"/>
  <path d="M24 86 h312" stroke="#fbc2ae" stroke-width="2" stroke-dasharray="10 16"/>
  <!-- vitrin -->
  <rect x="32" y="118" width="196" height="136" rx="4" fill="#dfe9ee" stroke="#0e2a3b" stroke-width="3"/>
  <path d="M130 118 v136" stroke="#0e2a3b" stroke-width="3"/>
  <path d="M46 132 l40 0 M46 140 l26 0" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".8"/>
  <!-- içerideki menü panosu -->
  <rect x="146" y="132" width="68" height="42" rx="3" fill="#0e2a3b"/>
  <path d="M154 144 h34 M154 152 h44 M154 160 h28" stroke="#f5b83d" stroke-width="3" stroke-linecap="round"/>
  <!-- tezgâh ve bowl'lar -->
  <rect x="40" y="214" width="180" height="40" fill="#173d55"/>
  <g><ellipse cx="66" cy="210" rx="16" ry="6" fill="#0e2a3b"/><ellipse cx="66" cy="207" rx="12" ry="4" fill="#ee6a4e"/></g>
  <g><ellipse cx="102" cy="210" rx="16" ry="6" fill="#0e2a3b"/><ellipse cx="102" cy="207" rx="12" ry="4" fill="#9fc46a"/></g>
  <g><ellipse cx="160" cy="210" rx="16" ry="6" fill="#0e2a3b"/><ellipse cx="160" cy="207" rx="12" ry="4" fill="#f5b83d"/></g>
  <!-- kapı -->
  <rect x="246" y="118" width="80" height="152" rx="4" fill="#24506c" stroke="#0e2a3b" stroke-width="3"/>
  <rect x="256" y="130" width="60" height="92" rx="3" fill="#dfe9ee"/>
  <rect x="304" y="196" width="5" height="28" rx="2.5" fill="#f5b83d"/>
  <text x="286" y="182" text-anchor="middle" font-family="DM Sans Variable, sans-serif" font-size="11" font-weight="700" fill="#0e2a3b">{openLabel}</text>
  <!-- saksı -->
  <rect x="4" y="244" width="24" height="26" rx="3" fill="#c4442a"/>
  <path d="M16 244 q-14 -20 -6 -34 q6 12 6 34 q0 -24 10 -32 q4 18 -10 32" fill="#6e9a3c"/>
</svg>
