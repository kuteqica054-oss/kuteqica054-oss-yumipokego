---
import type { Lang } from '../../i18n/routes';
import { useT, pick, formatValue, type Num } from '../../i18n/utils';
import site from '../../config/site.json';
import FloorPlan from '../art/FloorPlan.astro';
import PhotoSlot from '../ui/PhotoSlot.astro';
import Value from '../ui/Value.astro';
import Todo from '../ui/Todo.astro';
interface Props { lang: Lang; format: any; detailed?: boolean; index?: number }
const { lang, format: f, detailed = false, index = 0 } = Astro.props;
const t = useT(lang);
const L = t.formats.labels;
const name = pick(f.name, lang) as string;
---
<article class:list={['card overflow-hidden', detailed && 'grid lg:grid-cols-2']} id={f.id} data-reveal>
  <div class:list={['border-b border-line bg-rice p-4 sm:p-5', detailed && 'lg:border-b-0 lg:border-r']}>
    <PhotoSlot src={f.photo} alt={name} size="1600×1000 — formats.json → photo" class="aspect-[400/260] overflow-hidden rounded-xl">
      <FloorPlan type={f.plan} lang={lang} title={`${name} — ${t.formats.planTitle}`} />
    </PhotoSlot>
    {detailed && f.photo && <div class="mt-3"><FloorPlan type={f.plan} lang={lang} title={`${name} — ${t.formats.planTitle}`} /></div>}
    <p class="mt-2 text-xs text-ink-soft">{t.formats.planTitle} · {t.formats.planNote}</p>
  </div>
  <div class="flex flex-col p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-display text-sm font-bold text-coral-700">0{index + 1}</span>
      {f.offered === null && <Todo label={t.common.offeredTodo} />}
    </div>
    <h3 class="mt-1 text-2xl font-bold">{name}</h3>
    <p class="mt-1 font-medium text-ink">{pick(f.tagline, lang)}</p>
    {detailed && <p class="mt-3 text-ink-soft">{pick(f.text, lang)}</p>}
    {detailed && (
      <ul class="mt-4 space-y-1.5 text-[0.95rem]">
        {(pick(f.features, lang) as string[]).map((x) => <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-avocado-500"></span>{x}</li>)}
      </ul>
    )}
    <dl class="mt-auto grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4 text-sm" style="margin-top:1.25rem">
      <div><dt class="text-ink-soft">{L.area}</dt><dd class="font-semibold"><Value value={f.area as Num} unit="area" lang={lang} /></dd></div>
      <div><dt class="text-ink-soft">{L.seats}</dt><dd class="font-semibold">{f.seats ? <Value value={f.seats as Num} unit="count" lang={lang} /> : f.seatsNote ? pick(f.seatsNote, lang) : <Value value={null} unit="count" lang={lang} />}</dd></div>
      <div><dt class="text-ink-soft">{L.staff}</dt><dd class="font-semibold"><Value value={f.staff as Num} unit="count" lang={lang} /></dd></div>
      {(site.showTodos || formatValue(pick(f.investment, lang) as Num, 'money', lang)) && <div><dt class="text-ink-soft">{L.investment}</dt><dd class="font-semibold"><Value value={pick(f.investment, lang) as Num} unit="money" lang={lang} /></dd></div>}
    </dl>
  </div>
</article>
