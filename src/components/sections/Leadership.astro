---
import type { Lang } from '../../i18n/routes';
import { useT, pick } from '../../i18n/utils';
import PhotoSlot from '../ui/PhotoSlot.astro';
import Todo from '../ui/Todo.astro';
import site from '../../config/site.json';
import SocialIcon from '../ui/SocialIcon.astro';
interface Props { lang: Lang; people: any[]; compact?: boolean }
const { lang, people, compact = false } = Astro.props;
const t = useT(lang).corporatePage;
---
<ul class:list={['grid gap-4', compact ? 'grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-4']}>
  {people.map((p, i) => (
    <li class="card overflow-hidden" data-reveal>
      <PhotoSlot src={p.photo} alt={p.name ?? pick(p.role, lang)} size="800×800 — leadership.json → photo" class="aspect-square bg-rice-2" width={800} height={800}>
        <svg viewBox="0 0 200 200" class="h-full w-full" aria-hidden="true">
          <rect width="200" height="200" fill={['#fbe1d8', '#e3edd3', '#fcebc4', '#e4ecf0'][i % 4]} />
          <circle cx="100" cy="80" r="34" fill="#0e2a3b" opacity=".18" />
          <path d="M40 200 q0 -70 60 -70 q60 0 60 70z" fill="#0e2a3b" opacity=".18" />
        </svg>
      </PhotoSlot>
      <div class="p-4">
        {p.name || site.showTodos ? (
          <>
            <p class="font-display text-lg font-bold leading-tight">{p.name ?? <span class="text-ink-soft">{t.nameTodo} <Todo /></span>}</p>
            <p class="mt-1 text-sm text-coral-700">{pick(p.role, lang)}</p>
          </>
        ) : <p class="font-display text-lg font-bold leading-tight">{pick(p.role, lang)}</p>}
        {!compact && <p class="mt-2 text-sm text-ink-soft">{pick(p.bio, lang) ?? pick(p.desc, lang)}</p>}
        {p.linkedin && <a href={p.linkedin} target="_blank" rel="noopener" class="mt-3 inline-flex text-ink-soft hover:text-ink" aria-label={`LinkedIn — ${p.name}`}><SocialIcon name="linkedin" size={18} /></a>}
      </div>
    </li>
  ))}
</ul>
