---
import type { Lang } from '../../i18n/routes';
import { path } from '../../i18n/routes';
import { useT } from '../../i18n/utils';
import { bowlSvg } from '../../lib/art';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section class="container-x py-16 md:py-20">
  <div class="on-dark pattern-rice-dark relative overflow-hidden rounded-[28px] bg-ink px-6 py-10 text-white sm:px-10 md:px-14 md:py-14" data-reveal>
    <svg viewBox="-132 -132 264 264" class="pointer-events-none absolute -right-16 -bottom-20 w-[260px] opacity-90 md:-right-10 md:-bottom-16 md:w-[340px]" aria-hidden="true" set:html={bowlSvg({ toppings: ['salmon', 'avocado', 'mango', 'edamame', 'cucumber'], seed: 99, idPrefix: 'cta' })} />
    <div class="relative max-w-xl">
      <h2 class="h-section text-white">{t.cta.title}</h2>
      <p class="lead mt-4">{t.cta.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={path('apply', lang)} class="btn-primary">{t.common.apply}</a>
        <a href={path('contact', lang)} class="btn-ghost-light">{t.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>
