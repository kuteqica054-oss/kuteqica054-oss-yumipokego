---
import type { Lang } from '../../i18n/routes';
import { useT, pick, type Num, type Unit } from '../../i18n/utils';
import franchise from '../../data/franchise.json';
import Value from '../ui/Value.astro';
interface Props { lang: Lang; ids?: string[] }
const { lang, ids } = Astro.props;
const t = useT(lang).investmentPage;
const rows = ids ? franchise.fees.filter((f) => ids.includes(f.id)) : franchise.fees;
---
<div class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-white">
  <table class="w-full text-left text-[0.95rem]">
    <caption class="sr-only">{t.tableTitle}</caption>
    <thead class="hidden bg-rice-2 text-sm text-ink-soft sm:table-header-group">
      <tr><th scope="col" class="px-5 py-3 font-semibold">{t.tableItem}</th><th scope="col" class="px-5 py-3 font-semibold">{t.tableValue}</th><th scope="col" class="px-5 py-3 font-semibold">{t.tableDetail}</th></tr>
    </thead>
    <tbody class="divide-y divide-line">
      {rows.map((r) => (
        <tr class="grid grid-cols-1 gap-1 px-5 py-4 sm:table-row sm:p-0">
          <th scope="row" class="font-display text-base font-bold sm:px-5 sm:py-4">{pick(r.label, lang)}</th>
          <td class="font-display text-xl font-bold text-coral-700 sm:px-5 sm:py-4 sm:whitespace-nowrap"><Value value={pick(r.value as any, lang) as Num} unit={r.unit as Unit} lang={lang} /></td>
          <td class="text-sm text-ink-soft sm:px-5 sm:py-4">{pick(r.detail, lang)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
